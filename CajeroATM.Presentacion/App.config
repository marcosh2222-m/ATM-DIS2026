<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <!--
    Cadena de conexión a MySQL. La lee CajeroATM.Datos.Conexion.
    La base "cajero_atm_db" se crea con BaseDeDatos/01 y 02.
    Recomendado: usar el usuario "cajero_app" (script 00), que solo puede
    ejecutar stored procedures. Para empezar rápido sirve root.
  -->
  <connectionStrings>
    <add name="CajeroATM"
         connectionString="Server=localhost;Port=3306;Database=cajero_atm_db;User ID=cajero_app;Password=CambiarEsta.2026;"
         providerName="MySqlConnector" />
  </connectionStrings>

  <appSettings>
    <!-- Cajero físico en el que corre la aplicación (tabla Cajero).
         Los SP lo registran en cada transacción. -->
    <add key="IdCajero" value="1" />
  </appSettings>
</configuration>
