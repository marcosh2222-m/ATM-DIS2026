<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <!--
    Las pruebas crean y borran sus propios datos (cliente "Prueba Automática",
    cuentas 9901-*, tarjetas 4999*), así que este usuario necesita permisos de
    INSERT/DELETE además de EXECUTE: usá root u otro usuario administrador,
    NO el usuario cajero_app de la aplicación.
  -->
  <connectionStrings>
    <add name="CajeroATM"
         connectionString="Server=localhost;Port=3306;Database=cajero_atm_db;User ID=root;Password=CAMBIAR_PASSWORD;"
         providerName="MySqlConnector" />
  </connectionStrings>
  <appSettings>
    <add key="IdCajero" value="1" />
  </appSettings>
</configuration>
